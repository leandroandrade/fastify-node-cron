{
  "name": "fastify-node-cron",
  "version": "2.0.0",
  "description": "This module provides a way run scheduler workers using node-cron with fastify, featuring native node-cron v4 options and graceful shutdown.",
  "main": "index.js",
  "scripts": {
    "lint": "standard | snazzy",
    "lint:fix": "standard --fix | snazzy",
    "test": "npm run lint && npm run unit",
    "unit": "node --test --test-concurrency=1 ./test/**/*.test.js"
  },
  "keywords": [
    "cron",
    "node-cron",
    "scheduler",
    "jobs"
  ],
  "bugs": {
    "url": "https://github.com/leandroandrade/fastify-node-cron/issues"
  },
  "author": {
    "name": "Leandro Andrade",
    "email": "leandro.andrade2588@gmail.com",
    "url": "https://github.com/leandroandrade"
  },
  "homepage": "https://github.com/leandroandrade/fastify-node-cron#readme",
  "license": "MIT",
  "devDependencies": {
    "fastify": "^5.6.1",
    "sinon": "^21.0.0",
    "snazzy": "^9.0.0",
    "standard": "^17.1.2"
  },
  "dependencies": {
    "fastify-plugin": "^5.1.0",
    "node-cron": "^4.2.1"
  }
}
